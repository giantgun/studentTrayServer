generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model business {
  businessId      Int      @id @default(autoincrement())
  userId          Int      @unique(map: "Business_userId_key")
  firstName       String
  lastName        String
  businessName    String
  address         String
  nearestSchoolId Int
  phoneNumber     String
  businessEmail   String
  description     String   @db.LongText
  photoUrl        String?  @db.VarChar(255)
  coverPhotoUrl   String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  school          school   @relation(fields: [nearestSchoolId], references: [schoolId], map: "Business_nearestSchoolId_fkey")
  user            user     @relation(fields: [userId], references: [userId], map: "Business_userId_fkey")
  review          review[]

  @@index([nearestSchoolId], map: "Business_nearestSchoolId_fkey")
}

model item {
  itemId               Int           @id @default(autoincrement())
  userId               Int
  imagesUrlArrayString String        @db.Text
  title                String
  description          String        @db.LongText
  price                Int
  condition            String
  category             String
  numberInStock        Int
  videoUrl             String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  tier                 String        @default("free")
  user                 user          @relation(fields: [userId], references: [userId], map: "Item_userId_fkey")
  item_school          item_school[]

  @@index([userId], map: "Item_userId_fkey")
  @@fulltext([description])
  @@fulltext([description, title])
}

model item_school {
  itemId   Int
  schoolId Int
  item     item   @relation(fields: [itemId], references: [itemId], map: "Item_School_itemId_fkey")
  school   school @relation(fields: [schoolId], references: [schoolId], map: "Item_School_schoolId_fkey")

  @@id([itemId, schoolId])
  @@index([schoolId], map: "Item_School_schoolId_fkey")
}

model lodge {
  lodgeId                Int      @id @default(autoincrement())
  userId                 Int
  schoolId               Int
  imagesUrlArrayString   String   @db.Text
  propertyType           String
  numberOfBedrooms       Int
  numberOfBathrooms      Int
  paymentFrequency       String
  price                  Int
  priceType              String
  location               String
  nearestSchool          String
  walkingTime            Int
  kekeTime               Int
  description            String   @db.LongText
  WiFi                   Boolean  @default(false)
  parking                Boolean  @default(false)
  electricity            Boolean  @default(false)
  water                  Boolean  @default(false)
  electricityDescription String   @db.LongText
  waterDescription       String   @db.LongText
  networkQuality         String
  networkDescription     String   @db.LongText
  videoUrl               String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  numberOfLodges         Int
  agentFee               Int
  tier                   String   @default("free")
  school                 school   @relation(fields: [schoolId], references: [schoolId], map: "Lodge_schoolId_fkey")
  user                   user     @relation(fields: [userId], references: [userId], map: "Lodge_userId_fkey")

  @@index([schoolId], map: "Lodge_schoolId_fkey")
  @@index([userId], map: "Lodge_userId_fkey")
  @@fulltext([description])
  @@fulltext([description, propertyType])
}

model review {
  reviewId      Int       @id @default(autoincrement())
  userId        Int?
  businessId    Int?
  numberOfStars Int
  description   String    @db.LongText
  ownerUserId   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  business      business? @relation(fields: [businessId], references: [businessId], map: "Review_businessId_fkey")
  user          user?     @relation(fields: [userId], references: [userId], map: "Review_userId_fkey")

  @@index([businessId], map: "Review_businessId_fkey")
  @@index([userId], map: "Review_userId_fkey")
}

model room {
  roomId                 Int      @id @default(autoincrement())
  userId                 Int
  schoolId               Int
  imagesUrlArrayString   String   @db.Text
  propertyType           String
  numberOfBedrooms       Int
  numberOfBathrooms      Int
  paymentFrequency       String
  price                  Int
  priceType              String
  location               String
  nearestSchool          String
  walkingTime            Int
  kekeTime               Int
  description            String   @db.LongText
  WiFi                   Boolean  @default(false)
  parking                Boolean  @default(false)
  electricity            Boolean  @default(false)
  water                  Boolean  @default(false)
  electricityDescription String   @db.LongText
  waterDescription       String   @db.LongText
  networkQuality         String
  networkDescription     String   @db.LongText
  ownerName              String
  ownerPhone             String
  ownerProgramme         String
  yearOfStudy            String
  dateOfBirth            String
  additionalInfo         String?  @db.LongText
  videoUrl               String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  tier                   String   @default("free")
  school                 school   @relation(fields: [schoolId], references: [schoolId], map: "Room_schoolId_fkey")
  user                   user     @relation(fields: [userId], references: [userId], map: "Room_userId_fkey")

  @@index([schoolId], map: "Room_schoolId_fkey")
  @@index([userId], map: "Room_userId_fkey")
  @@fulltext([description])
  @@fulltext([description, propertyType])
}

model school {
  schoolId       Int              @id @default(autoincrement())
  schoolName     String           @unique(map: "School_schoolName_key") @db.VarChar(255)
  createdAt      DateTime         @default(now())
  business       business[]
  item_school    item_school[]
  lodge          lodge[]
  room           room[]
  service_school service_school[]
  user           user[]
}

model service {
  serviceId                 Int              @id @default(autoincrement())
  userId                    Int
  imagesUrlArrayString      String           @db.Text
  title                     String
  description               String           @db.LongText
  price                     Int
  category                  String
  online                    String           @default("")
  inPerson                  String           @default("")
  jsonStingifiedAvailabilty String
  priceType                 String
  videoUrl                  String?          @db.Text
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime
  tier                      String           @default("free")
  user                      user             @relation(fields: [userId], references: [userId], map: "Service_userId_fkey")
  service_school            service_school[]

  @@index([userId], map: "Service_userId_fkey")
  @@fulltext([description])
  @@fulltext([description, title])
}

model service_school {
  serviceId Int
  schoolId  Int
  school    school  @relation(fields: [schoolId], references: [schoolId], map: "Service_School_schoolId_fkey")
  service   service @relation(fields: [serviceId], references: [serviceId], map: "Service_School_serviceId_fkey")

  @@id([serviceId, schoolId])
  @@index([schoolId], map: "Service_School_schoolId_fkey")
}

model user {
  userId          Int       @id @default(autoincrement())
  username        String    @unique(map: "User_username_key") @db.VarChar(255)
  email           String    @unique(map: "User_email_key") @db.VarChar(255)
  password        String    @db.VarChar(255)
  photoUrl        String?   @db.VarChar(255)
  phoneNumber     String    @db.VarChar(255)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  schoolId        Int
  itemsPaidFor    Int?      @default(0)
  lodgesPaidFor   Int?      @default(0)
  roomsPaidFor    Int?      @default(0)
  servicesPaidFor Int?      @default(0)
  business        business?
  item            item[]
  lodge           lodge[]
  review          review[]
  room            room[]
  service         service[]
  school          school    @relation(fields: [schoolId], references: [schoolId], map: "User_schoolId_fkey")

  @@index([schoolId], map: "User_schoolId_fkey")
}
